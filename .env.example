# ==============================================================================
# Medicare Policy Insight & Dynamic RAG System - Environment Configuration
# ==============================================================================

# 1. Primary Engine: Groq Cloud API Keys (Free Tier: https://console.groq.com/keys)
GROQ_API_KEY1=gsk_your_primary_groq_api_key_here
GROQ_API_KEY2=gsk_your_secondary_groq_api_key_here
GROQ_API_KEY3=gsk_your_tertiary_groq_api_key_here

# 2. Fallback Engine: Google Gemini API Keys (Free Tier: https://aistudio.google.com/apikey)
GOOGLE_API_KEY1=your_primary_gemini_api_key_here
GOOGLE_API_KEY2=your_secondary_gemini_api_key_here
GOOGLE_API_KEY3=your_tertiary_gemini_api_key_here

# 3. Provider Order and Execution Strategy
PRIMARY_PROVIDER=groq
PROVIDER_CHAIN=groq,gemini

# 4. Model Configurations
GROQ_MODEL1=openai/gpt-oss-120b
GROQ_MODEL2=openai/gpt-oss-20b
GEMINI_MODEL1=gemini-3.6-flash
GEMINI_MODEL2=gemini-3.5-flash-lite
